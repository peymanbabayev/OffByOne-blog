# === Neon PostgreSQL ===
# Runtime (Connection Pooling linki) — src/lib/prisma.ts istifadə edir
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Migrations & CLI (birbaşa direct link) — prisma.config.ts istifadə edir
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# === Vercel Blob ===
# Şəkil yükləmə anbarı (post örtük şəkli + avatar). Vercel dashboard → Storage → Blob
# store yaradıb tokeni buraya köçürün. Vercel-ə deploy olunanda avtomatik təyin olunur.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === Auth ===
# Kriptoqrafik təsadüfi açar (min 256-bit). Yaratmaq üçün: openssl rand -hex 32
JWT_SECRET="replace-with-openssl-rand-hex-32"

# === Seed (prisma db seed) ===
# Admin hesabı YALNIZ bu dəyişənlər varsa yaradılır. Parol siyasəti:
# min 8 simvol + ən azı bir hərf + ən azı bir rəqəm.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-8chars1"
# SEED_ADMIN_NAME="Ad Soyad"   # opsional, default: "Peyman Babayev"
