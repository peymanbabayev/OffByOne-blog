# === Sayt URL-i (SEO, Sitemap və OpenGraph üçün) ===
# İstehsalatda domen ünvanı (məs: https://offbyoneblog.duckdns.org), lokalda http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# === Neon PostgreSQL ===
# Runtime (Connection Pooling linki) — src/lib/prisma.ts istifadə edir
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Migrations & CLI (birbaşa direct link) — prisma.config.ts istifadə edir
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# === Vercel Blob ===
# Şəkil yükləmə anbarı (post örtük şəkli + avatar). Vercel dashboard → Storage → Blob
# store yaradıb tokeni buraya köçürün. Vercel-ə deploy olunanda avtomatik təyin olunur.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === Auth ===
# Kriptoqrafik təsadüfi açar (min 256-bit). Yaratmaq üçün: openssl rand -hex 32
JWT_SECRET="replace-with-openssl-rand-hex-32"

# === AI örtük şəkli (Cloudflare Workers AI) ===
# Post formasındakı "AI ilə şəkil yarat" düyməsi üçün. Pulsuz plan: gündə 10 000 neuron,
# bir şəkil ≈ 61 neuron. Dəyərlər yoxdursa düymə "funksiya əlçatan deyil" xətası verir.
# Account ID: Cloudflare dashboard → Workers & Pages (sağ panel).
# Token: My Profile → API Tokens → "Workers AI" şablonu (Workers AI: Read/Edit).
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-workers-ai-api-token"
# Gündəlik limitlər (UTC günü). Default: istifadəçi başına 2, bütün sayt üzrə 60 (~3 700 neuron).
AI_IMAGE_DAILY_LIMIT_PER_USER=2
AI_IMAGE_DAILY_LIMIT_GLOBAL=60

# === Seed (prisma db seed) ===
# Admin hesabı YALNIZ bu dəyişənlər varsa yaradılır. Parol siyasəti:
# min 8 simvol + ən azı bir hərf + ən azı bir rəqəm.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-8chars1"
# SEED_ADMIN_NAME="Ad Soyad"   # opsional, default: "Peyman Babayev"
