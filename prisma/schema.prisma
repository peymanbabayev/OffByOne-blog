generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           Role     @default(USER)
  avatar         String?
  // Sessiya ləğvi (revocation) sayğacı: artırıldıqda bu istifadəçinin bütün
  // mövcud JWT tokenləri DAL səviyyəsində etibarsız sayılır ("bütün cihazlardan çıxış").
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  posts          Post[]
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  category  String   @default("Mühəndislik")
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
